# Copia este contenido en Streamlit Community Cloud: tu app > Settings > Secrets
# (en tu computadora, guárdalo como .streamlit/secrets.toml; ese archivo no se sube a GitHub).
# La forma más fácil: corre  python generar_codigos.py  y copia el secrets.toml que genera.

[onedrive]
# Vínculo para compartir el Excel (OneDrive > Compartir > Copiar vínculo)
link = "https://sdldiconsa1-my.sharepoint.com/:x:/g/personal/jgil_alimentacionbienestar_gob_mx/IQAMMYIoAdV3R64jYKkkxY-dAa80op6GuFgIqRefBMflTcw?e=fPzDSj"

# Excel complementarios (en cualquier orden: el tablero reconoce cada uno por su contenido)
#   - Catálogo de Artículos (fecha de alta). Solo se usan los artículos que están en el Excel de arriba.
#   - Artículos vigentes con IMPORTE PEDIDO (presupuesto) e IMPORTE SURTIDO (lo comprado por existencias).
link2 = "https://sdldiconsa1-my.sharepoint.com/:x:/g/personal/emponce_alimentacionbienestar_gob_mx/IQCdSwV9tG1JSIsbRaiaOQAPAfqA6NZiX1HATvJJN66da7o?e=16JeRV"
link3 = "https://sdldiconsa1-my.sharepoint.com/:x:/g/personal/emponce_alimentacionbienestar_gob_mx/IQBRXZ4faCc_R5Yn6pOGMGMrAS443ueG2Yfb0sIZBu0DeFY?e=N7vkRV"

# Cada cuántos minutos se vuelve a descargar el Excel (opcional, 10 por omisión)
minutos = 10

# Solo si tu organización NO permite vínculos públicos ("Cualquier persona con el vínculo").
# tenant_id = ""
# client_id = ""
# client_secret = ""

[acceso]
# Código del administrador: ve todo el programa y puede abrir el tablero de cualquier proveedor.
# Sin la sección [acceso], el tablero abre directo en modo administrador (solo para pruebas).
admin = "XXXX-XXXX"

[acceso.proveedores]
# CVE del proveedor = su código de acceso
"653" = "XXXX-XXXX"
